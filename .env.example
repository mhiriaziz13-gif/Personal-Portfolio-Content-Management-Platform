NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public hCaptcha widget configuration. Configure the same provider in Supabase
# Auth; the server secret is also required for the public contact endpoint.
NEXT_PUBLIC_CAPTCHA_PROVIDER=hcaptcha
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

NEXT_PUBLIC_SITE_URL=https://ahmedaziz-portfolio.vercel.app
APP_URL=https://ahmedaziz-portfolio.vercel.app
# Local loopback origins are added automatically outside production.
ALLOWED_ORIGINS=https://ahmedaziz-portfolio.vercel.app

REQUIRE_ADMIN_MFA=true
ADMIN_MFA_REMEMBER_DAYS=10

# Generate three different values, each with at least 32 random bytes. Never
# reuse an application secret or Supabase key, and never expose these with a
# NEXT_PUBLIC_ prefix. ADMIN_DEVICE_HMAC_SECRET has no fallback.
RATE_LIMIT_HMAC_SECRET=
PRIVACY_HMAC_SECRET=
ADMIN_DEVICE_HMAC_SECRET=

# Contact notifications are attempted only after the message is persisted.
# Failed delivery is retried manually from admin; no scheduler is deployed.
RESEND_API_KEY=
CONTACT_NOTIFICATION_TO=
CONTACT_NOTIFICATION_FROM=

NEXT_PUBLIC_GITHUB_USERNAME=mhiriaziz13-gif
NEXT_PUBLIC_GITHUB_PROFILE_URL=
NEXT_PUBLIC_LINKEDIN_PROFILE_URL=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional isolated integration-test project. Never point these at production.
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
PRODUCTION_SUPABASE_PROJECT_REF=
ALLOW_TEST_DATABASE_MUTATIONS=false

# Optional authenticated Playwright lifecycle project. The storage-state file
# must contain an AAL2 admin session for the same non-production project.
E2E_TEST_SUPABASE_URL=
E2E_TEST_SUPABASE_ANON_KEY=
E2E_TEST_SUPABASE_SERVICE_ROLE_KEY=
E2E_ADMIN_STORAGE_STATE=
ALLOW_E2E_DATABASE_MUTATIONS=false
